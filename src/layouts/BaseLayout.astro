---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@/config/site';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import AgeGate from '@/components/layout/AgeGate.astro';
import BackToTop from '@/components/layout/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, image, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – ${SITE.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0e0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Navegación sin recarga completa (tipo SPA) con transiciones animadas -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <AgeGate />
  </body>
</html>
