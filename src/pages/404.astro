---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <Container class="grid justify-items-center gap-4 py-24 text-center">
    <p class="font-display text-hero leading-none font-bold text-accent">404</p>
    <h1 class="text-2xl uppercase">Esta puerta del bunker está cerrada</h1>
    <p class="text-muted">La página que buscas no existe o fue movida.</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <Button href="/">Volver al inicio</Button>
      <Button href="/catalogo" variant="secondary">
        Ver catálogo
      </Button>
    </div>
  </Container>
</BaseLayout>
