---
import type { Product } from '@/types/catalog';
import ProductCard from './ProductCard.astro';
import { cn } from '@/utils/cn';

interface Props {
  products: Product[];
  emptyMessage?: string;
  class?: string;
}

const {
  products,
  emptyMessage = 'No hay productos disponibles por ahora.',
  class: className,
} = Astro.props;
---

{products.length > 0 ? (
  <ul
    class={cn(
      'grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] sm:gap-6',
      className,
    )}
  >
    {products.map((product) => (
      <li class="grid">
        <ProductCard product={product} />
      </li>
    ))}
  </ul>
) : (
  <p class="rounded-md border border-dashed border-line p-12 text-center text-muted">
    {emptyMessage}
  </p>
)}
