---
import type { Product } from '@/types/catalog';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  emptyMessage?: string;
}

const { products, emptyMessage = 'No hay productos disponibles por ahora.' } = Astro.props;
---

{products.length > 0 ? (
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] sm:gap-6">
    {products.map((product) => (
      <li class="grid">
        <ProductCard product={product} />
      </li>
    ))}
  </ul>
) : (
  <p class="rounded-md border border-dashed border-line p-12 text-center text-muted">
    {emptyMessage}
  </p>
)}
