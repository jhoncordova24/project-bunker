---
import { SITE } from '@/config/site';
---

<a href="/" class="inline-flex items-center gap-2 text-accent" aria-label={`${SITE.name} – inicio`}>
  <svg class="size-10" viewBox="0 0 64 64" aria-hidden="true">
    <!-- Dos vasos de whisky con hielo brindando -->
    <g fill="currentColor" transform="translate(32 33) scale(1.15) translate(-32 -41.0)">
      <g transform="translate(20.85 40) rotate(8)">
        <path d="M-8.6 1.5H8.6L8 8.5H-8z" opacity=".5"></path>
        <path d="M-8.6 1.5H8.6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
        <rect
          x="-6.2"
          y="-3.6"
          width="6.2"
          height="6.2"
          rx="1.2"
          transform="rotate(-12 -3.1 -.5)"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <rect
          x="0.9"
          y="-1.8"
          width="5.2"
          height="5.2"
          rx="1.1"
          transform="rotate(15 3.5 .8)"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <path d="M-8 8.5H8L7.6 12.5H-7.6z"></path>
        <path
          d="M-9.5 -12.5L-7.6 12.5H7.6L9.5 -12.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linejoin="round"
          stroke-linecap="round"
        ></path>
        <path
          d="M-9.5 -12.5H9.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          opacity=".8"
        ></path>
        <path
          d="M6 -9l-.6 8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity=".6"
        ></path>
      </g>
      <g transform="translate(43.15 40) scale(-1 1) rotate(8)">
        <path d="M-8.6 1.5H8.6L8 8.5H-8z" opacity=".5"></path>
        <path d="M-8.6 1.5H8.6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
        <rect
          x="-6.2"
          y="-3.6"
          width="6.2"
          height="6.2"
          rx="1.2"
          transform="rotate(-12 -3.1 -.5)"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <rect
          x="0.9"
          y="-1.8"
          width="5.2"
          height="5.2"
          rx="1.1"
          transform="rotate(15 3.5 .8)"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <path d="M-8 8.5H8L7.6 12.5H-7.6z"></path>
        <path
          d="M-9.5 -12.5L-7.6 12.5H7.6L9.5 -12.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linejoin="round"
          stroke-linecap="round"
        ></path>
        <path
          d="M-9.5 -12.5H9.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          opacity=".8"
        ></path>
        <path
          d="M6 -9l-.6 8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity=".6"
        ></path>
      </g>
      <path
        d="M32 24.9v-6M26.8 25.9l-3.2-4.2M37.2 25.9l3.2-4.2"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
      ></path>
    </g>
  </svg>
  <span class="grid gap-[3px] leading-none">
    <span class="font-display text-xl leading-none font-bold tracking-wider text-foreground uppercase">
      {SITE.name}
    </span>
    <span class="text-[0.65rem] leading-none tracking-ultra text-accent uppercase">
      {SITE.tagline}
    </span>
  </span>
</a>
