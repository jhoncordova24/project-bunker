---
import { SITE } from '@/config/site';
---

<a href="/" class="inline-flex items-center gap-2 text-accent" aria-label={`${SITE.name} – inicio`}>
  <img src="/logo.avif" alt="" width="149" height="200" class="h-11 w-auto" decoding="async" />
  <span class="grid gap-[3px] leading-none">
    <span class="font-display text-xl leading-none font-bold tracking-wider text-foreground uppercase">
      {SITE.name}
    </span>
    <span class="text-[0.65rem] leading-none tracking-ultra text-accent uppercase">
      {SITE.tagline}
    </span>
  </span>
</a>
