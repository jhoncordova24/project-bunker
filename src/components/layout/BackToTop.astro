---
/**
 * Botón flotante "volver arriba". Aparece al hacer scroll hacia abajo.
 */
import Icon from '@/components/ui/Icon.astro';
---

<button
  type="button"
  data-back-to-top
  aria-label="Volver arriba"
  class="invisible fixed right-4 bottom-4 z-40 grid size-[46px] translate-y-3 place-items-center rounded-full bg-accent text-accent-contrast opacity-0 shadow-elevated transition-[opacity,translate,visibility,background-color] duration-500 ease-out hover:bg-accent/85 data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 md:right-8 md:bottom-8"
>
  <Icon name="arrowUp" size={20} />
</button>

<script>
  /** Distancia de scroll (px) a partir de la cual se muestra el botón */
  const THRESHOLD = 400;

  const button = document.querySelector<HTMLElement>('[data-back-to-top]');
  let visible = false;

  // Solo toca el DOM cuando cambia el estado, no en cada evento de scroll.
  const update = () => {
    const next = window.scrollY > THRESHOLD;
    if (next === visible) return;
    visible = next;
    button?.toggleAttribute('data-visible', next);
  };

  window.addEventListener('scroll', update, { passive: true });
  update();

  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-back-to-top]')) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
