---
/**
 * Aviso "Muy pronto" para redes sociales que aún no existen.
 * Lo abre cualquier botón con `data-social-soon="<Nombre de la red>"`.
 */
import { SITE } from '@/config/site';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { buildWhatsAppLink } from '@/utils/whatsapp';
---

<dialog
  data-social-dialog
  aria-labelledby="social-soon-title"
  class="m-auto w-[calc(100%-2rem)] max-w-100 scale-95 rounded-lg border border-line bg-surface text-foreground opacity-0 shadow-elevated transition-[opacity,scale,display,overlay] transition-discrete duration-300 ease-out backdrop:bg-background/80 backdrop:opacity-0 backdrop:backdrop-blur-sm backdrop:transition-[opacity,display,overlay] backdrop:transition-discrete backdrop:duration-300 open:scale-100 open:opacity-100 open:backdrop:opacity-100 starting:open:scale-95 starting:open:opacity-0 starting:open:backdrop:opacity-0"
>
  <button
    type="button"
    data-social-close
    aria-label="Cerrar"
    class="absolute top-3 right-3 grid size-9 place-items-center rounded-sm text-muted transition-colors hover:text-foreground"
  >
    <Icon name="close" size={18} />
  </button>

  <div class="grid gap-3 p-8 text-center">
    <p class="font-display text-xs tracking-ultra text-accent uppercase">Muy pronto</p>
    <h2 id="social-soon-title" class="text-2xl uppercase">
      Estamos creando nuestro <span data-social-name>perfil</span>
    </h2>
    <p class="text-muted">
      Pronto podrás seguir a {SITE.name} en redes. Mientras tanto, escríbenos por WhatsApp
      para pedidos y novedades.
    </p>
    <div class="mt-3 flex justify-center">
      <Button href={buildWhatsAppLink()} external>Escríbenos</Button>
    </div>
  </div>
</dialog>

<script>
  // Delegación en `document`: sobrevive a las navegaciones del ClientRouter.
  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const dialog = document.querySelector<HTMLDialogElement>('[data-social-dialog]');
    if (!dialog) return;

    const trigger = target.closest<HTMLElement>('[data-social-soon]');
    if (trigger) {
      const name = dialog.querySelector('[data-social-name]');
      if (name) name.textContent = `${trigger.dataset.socialSoon}`;
      dialog.showModal();
      return;
    }

    // Cerrar con la X o haciendo clic fuera de la caja (en el backdrop)
    if (target.closest('[data-social-close]') || target === dialog) dialog.close();
  });
</script>
