---
import { SITE } from '@/config/site';
import { buildWhatsAppLink } from '@/utils/whatsapp';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

// Botellas decorativas del hero: debajo del texto en móvil, a la derecha en escritorio. Orden: izquierda, centro, derecha.
const bottles = [
  {
    src: '/images/products/flor-cania.avif',
    wrap: 'left-[-6%] bottom-[2%] h-[78%] -rotate-8 z-0',
    delay: '-2s',
  },
  {
    src: '/images/products/red-label.avif',
    wrap: 'left-1/2 -translate-x-1/2 bottom-0 h-full z-10',
    delay: '0s',
  },
  {
    src: '/images/products/jagermeister.avif',
    wrap: 'right-[-6%] bottom-[4%] h-[74%] rotate-7 z-0',
    delay: '-4s',
  },
];

// En móvil los dos botones van lado a lado, más compactos, para no robar altura.
const ctaClass = 'px-3 py-3 text-sm xs:px-8 xs:py-4 xs:text-base';
---

{/* Móvil/tablet: el hero ocupa justo una pantalla (bajo la cabecera) y las
    botellas se encogen para caber en el espacio que deja el texto.
    Escritorio: texto a la izquierda y botellas a la derecha. */}
<section class="bg-hero relative flex min-h-[calc(100svh-var(--spacing-header))] flex-col overflow-hidden border-b border-line py-8 md:py-12 lg:block lg:min-h-0 lg:py-36">
  <div aria-hidden="true" class="absolute inset-0">
    <div class="halo top-[5%] right-[8%] h-[50%] w-[32%] bg-radial-[closest-side] from-accent/14 to-transparent animate-drift-a motion-reduce:animate-none"></div>
    <div class="halo bottom-[-20%] left-[-10%] h-[65%] w-[45%] bg-radial-[closest-side] from-olive/40 to-transparent animate-drift-b motion-reduce:animate-none"></div>
    <div class="absolute inset-0 bg-radial-[ellipse_at_70%_40%] from-transparent from-30% to-background/90 to-80%"></div>
    <div class="grain md:animate-grain motion-reduce:animate-none"></div>
  </div>
  <Container class="relative flex flex-1 flex-col items-start justify-center gap-3 lg:grid lg:justify-normal lg:justify-items-start lg:gap-4">
    <div
      aria-hidden="true"
      style="animation-delay: 500ms"
      class="animate-fade-up motion-reduce:animate-none pointer-events-none relative order-last max-h-80 min-h-32 w-full flex-1 self-center lg:absolute lg:top-1/2 lg:right-8 lg:h-[130%] lg:max-h-none lg:min-h-0 lg:w-[44%] lg:max-w-150 lg:-translate-y-1/2"
    >
      {/* Cuadrado ajustado a la altura disponible: en móvil el grupo se
          encoge sin que las botellas se separen. */}
      <div class="absolute inset-y-0 left-1/2 aspect-square -translate-x-1/2 lg:right-0 lg:left-0 lg:aspect-auto lg:translate-x-0">
        {bottles.map((b) => (
          <div class:list={['absolute aspect-square', b.wrap]}>
            {/* La animación va en una capa propia y la sombra en la imagen: así la
              sombra se pinta una vez dentro de la capa en vez de recalcularse
              en la GPU en cada fotograma. */}
            <div
              style={`animation-delay: ${b.delay}`}
              class="size-full animate-float will-change-transform motion-reduce:animate-none"
            >
              <img
                src={b.src}
                alt=""
                loading="eager"
                decoding="async"
                width="500"
                height="500"
                class="size-full object-contain drop-shadow-[0_24px_30px_rgb(0_0_0/0.6)]"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
    <p
      style="animation-delay: 0ms"
      class="animate-fade-up motion-reduce:animate-none rounded-full border border-accent px-3 py-1 font-display text-xs tracking-ultra text-accent uppercase"
    >
      {SITE.tagline} · Delivery
    </p>
    <h1
      style="animation-delay: 100ms"
      class="animate-fade-up motion-reduce:animate-none text-hero font-bold tracking-wide uppercase"
    >
      {SITE.name}
    </h1>
    <p
      style="animation-delay: 200ms"
      class="animate-fade-up motion-reduce:animate-none font-display text-xl tracking-wider text-accent uppercase md:text-2xl"
    >
      {SITE.slogan}
    </p>
    <p
      style="animation-delay: 300ms"
      class="animate-fade-up motion-reduce:animate-none max-w-130 text-base text-muted md:text-lg"
    >
      Whiskies, rones, licores y mucho más. Elige, escríbenos por WhatsApp y te lo llevamos.
    </p>
    <div
      style="animation-delay: 400ms"
      class="animate-fade-up motion-reduce:animate-none mt-2 grid w-full grid-cols-2 gap-2 xs:flex xs:w-auto xs:flex-wrap xs:gap-3 md:mt-4"
    >
      <Button href="/catalogo" size="lg" class={ctaClass}>
        Ver catálogo <Icon name="arrowRight" size={18} />
      </Button>
      <Button href={buildWhatsAppLink()} external variant="secondary" size="lg" class={ctaClass}>
        <Icon name="whatsapp" size={18} /> <span><span class="hidden xs:inline">Pedir por </span>WhatsApp</span>
      </Button>
    </div>
  </Container>
</section>
