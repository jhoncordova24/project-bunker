---
import { SITE } from '@/config/site';
import { buildWhatsAppLink } from '@/utils/whatsapp';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
---

<section class="section">
  <Container>
    <div class="grid items-center gap-6 rounded-lg border border-accent bg-surface bg-radial-[ellipse_at_100%_0%] from-accent/16 to-transparent to-60% p-8 lg:grid-cols-[1.3fr_1fr_auto] lg:p-12">
      <div>
        <h2 class="text-2xl uppercase">¿Listo para abastecer el bunker?</h2>
        <p class="text-muted">Escríbenos y armamos tu pedido en minutos.</p>
      </div>
      <ul class="grid gap-3 text-sm text-muted">
        {SITE.hours.map((h) => (
          <li class="flex items-start gap-2">
            <Icon name="clock" size={16} class="mt-[3px] shrink-0 text-accent" />
            <span class="grid whitespace-nowrap">
              <strong class="font-medium text-foreground">{h.days}</strong>
              <span>{h.time}</span>
            </span>
          </li>
        ))}
      </ul>
      <Button href={buildWhatsAppLink()} external size="lg">
        <Icon name="whatsapp" size={18} /> Escríbenos
      </Button>
    </div>
  </Container>
</section>
