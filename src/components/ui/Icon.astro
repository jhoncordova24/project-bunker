---
/**
 * Set de iconos SVG inline.
 * - `strokeIcons`: de trazo (24x24), definidos aquí como paths.
 * - `fillIcons`: de relleno, cargados automáticamente desde `src/assets/icons/*.svg`
 *   (deben usar fill="currentColor"). El nombre del archivo es el nombre del icono.
 */
const svgFiles = import.meta.glob<string>('/src/assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const fillIcons: Record<string, { viewBox: string; body: string }> = Object.fromEntries(
  Object.entries(svgFiles).map(([path, svg]) => [
    path.split('/').pop()!.replace('.svg', ''),
    {
      viewBox: svg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 24 24',
      body: svg.replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, ''),
    },
  ]),
);

type FillIconName = 'whatsapp' | 'instagram' | 'facebook' | 'tiktok';

const strokeIcons = {
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  truck:
    '<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
  tag: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.2"/>',
  bottle:
    '<path d="M10 2h4v4l1.5 3V21a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1V9L10 6z"/><path d="M8.5 13h7"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  arrowUp: '<path d="M12 19V5M6 11l6-6 6 6"/>',
} as const;

export type IconName = keyof typeof strokeIcons | FillIconName;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const fillIcon = fillIcons[name];
const isFill = Boolean(fillIcon);
const content = fillIcon ? fillIcon.body : strokeIcons[name as keyof typeof strokeIcons];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={fillIcon?.viewBox ?? '0 0 24 24'}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? undefined : 'currentColor'}
  stroke-width={isFill ? undefined : '1.8'}
  stroke-linecap={isFill ? undefined : 'round'}
  stroke-linejoin={isFill ? undefined : 'round'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={content}
/>
